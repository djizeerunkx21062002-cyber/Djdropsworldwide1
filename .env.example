# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DOWNLOAD_SIGNING_SECRET: Optional HMAC secret for signed digital audio delivery links.
DOWNLOAD_SIGNING_SECRET=

# Optional SMTP settings for live automated milestone and order emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DropVault Audio <noreply@dropvault.audio>"
